# Copie para .env e preencha os valores reais. .env nunca deve ser commitado.

PORT=3333

# MySQL local (MySQL80 já roda como serviço no Windows)
DB_HOST=localhost
DB_PORT=3306
DB_USER=elite_dev_app
DB_PASSWORD=troque-pela-senha-do-seu-usuario-mysql
DB_NAME=elite_dev_ingressos

# Secrets JWT (gere valores aleatórios longos, nunca use os exemplos abaixo em produção)
JWT_SECRET=troque-por-um-valor-aleatorio-longo-para-login
QR_SECRET=troque-por-outro-valor-aleatorio-longo-diferente-para-qr

# TMDb (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# CORS — origem do frontend em produção (Vercel). Em dev, localhost:5173 já é liberado por padrão.
FRONTEND_ORIGIN=http://localhost:5173
